{
  "name": "rps-chess",
  "version": "1.0.0",
  "description": "JANKEN — a rock-paper-scissors strategy game played like chess. Deployed at rps.subsurfaces.net.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "verify": "npm run check:syntax && npm test",
    "deploy:dry": "npm run verify && wrangler deploy --dry-run",
    "version:stamp": "node scripts/version.mjs",
    "d1:migrate": "wrangler d1 migrations apply rps-chess --remote",
    "d1:migrate:local": "wrangler d1 migrations apply rps-chess --local",
    "deploy": "npm run verify && node scripts/assert-clean.mjs && node scripts/version.mjs && npm run d1:migrate && wrangler deploy",
    "tail": "wrangler tail rps-chess",
    "preview": "wrangler dev --remote",
    "tablebase": "node scripts/tablebase.mjs",
    "lab": "node scripts/lab.mjs",
    "tune": "node scripts/tune.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@playwright/test": "1.61.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.100.0"
  }
}
