{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rps-chess",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rps-chess",
      "database_id": "af563d71-f96d-4758-9bad-1215443feef5",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }
  ],
  "routes": [
    {
      "pattern": "rps.subsurfaces.net",
      "custom_domain": true
    }
  ]
}
