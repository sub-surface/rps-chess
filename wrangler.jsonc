{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rps-chess",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }
  ],
  "routes": [
    {
      "pattern": "rps.subsurfaces.net",
      "custom_domain": true
    }
  ]
}
